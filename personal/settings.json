{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",

      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",

      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(kubectl delete namespace*)",
      "Bash(kubectl delete ns*)",

      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh release*)",
      "Bash(crontab*)"
    ]
  },

  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never run DROP TABLE, DROP DATABASE, DROP SCHEMA, or TRUNCATE against any database",
      "Never run DELETE FROM without a WHERE clause",
      "Never run a destructive migration against a production database or connection string",
      "Never rewrite published git history on a shared branch"
    ],
    "soft_deny": [
      "$defaults",
      "Do not install global packages without saying so first",
      "Do not modify .gitignore unless asked"
    ]
  },

  "includeCoAuthoredBy": false,

  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoMemoryEnabled": true
}
